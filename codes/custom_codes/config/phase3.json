{
  "train_txt": "../../custom_dataset/Anthem_dataset/train_data.txt",
  "test_txt": "../../custom_dataset/Anthem_dataset/test_data.txt",
  "pseudo_csv": "../../custom_dataset/Anthem_dataset/mhc_ii_pseudo.csv",
  "out_dir": "reports_phase3_capsnet",

  "n_folds": 5,
  "epochs": 40,
  "batch_size": 32,
  "lr": 2e-4,
  "weight_decay": 1e-6,
  "grad_clip": 1.0,
  "seed": 42,

  "dropout": 0.3,
  "pep_channels": [64, 128],
  "core_kernel": 9,
  "pseudo_channels": [32, 64],
  "cap_dim": 8,
  "out_cap_dim": 16,
  "routing_iters": 3,
  "n_full_caps": 32,
  "n_core_caps": 16,
  "n_mhc_caps": 8,

  "lambda_reg": 0.5,
  "entropy_beta": 0.01,
  "auto_pos_weight": true,
  "pos_weight": 18.5,

  "warm_start": true,
  "warm_start_core_only": false,
  "phase2_ckpt_dir": "reports_phase2_affinity_from_scratch/checkpoints"
}
